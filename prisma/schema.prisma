generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERER
  CASHIER
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones arregladas para cubrir tus 4 roles
  ordersAsCustomer  Order[] @relation("CustomerOrders")
  ordersAsDeliverer Order[] @relation("DelivererOrders")
  ordersAsCashier   Order[] @relation("CashierOrders")

  @@map("users") 
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2) // Manejo profesional de dinero
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10, 2)
  address     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 1. El cliente que compra (Obligatorio)
  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  
  // 2. El domiciliario que entrega (Opcional al inicio)
  delivererId String?
  deliverer   User?       @relation("DelivererOrders", fields: [delivererId], references: [id])

  // 3. El cajero que despacha (Opcional al inicio)
  cashierId   String?
  cashier     User?       @relation("CashierOrders", fields: [cashierId], references: [id])

  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) 

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}